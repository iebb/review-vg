{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "review-vg",
  "account_id": "599ee1cd6c4d3dc453d290c4c0477e76",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "addresses": ["*@review.vg"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "review.vg",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "review-vg",
      "database_id": "7cf0ee57-3d74-46ed-b62d-cfa1c8f89396",
      "migrations_dir": "./migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
